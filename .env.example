# Copy this file to .env and fill only the providers you use.

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
KESTREL_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
KESTREL_DEEPSEEK_API_KEY=
KESTREL_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
KESTREL_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
KESTREL_OPENAI_API_BASE=https://www.right.codes/codex/v1
KESTREL_OPENAI_API_KEY=
KESTREL_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse KESTREL_RIGHT_CODES_API_KEY when your gateway shares one key.
KESTREL_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
KESTREL_ANTHROPIC_API_KEY=
KESTREL_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
KESTREL_SECRET_ENV_NAMES=
